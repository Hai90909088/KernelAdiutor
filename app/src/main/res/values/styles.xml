<resources>

    <style name="AppTheme" parent="Base.Theme.AppCompat">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">@color/amoled_bg</item>
        <item name="android:colorBackground">@color/amoled_bg</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/textcolor_dark</item>
        <item name="android:textColorPrimaryInverse">@color/black</item>
        <item name="android:textAlignment">gravity</item>
        <item name="android:textDirection">locale</item>
        <item name="dim_dialog_background">#cc000000</item>
    </style>

    <style name="AppThemeDark" parent="AppTheme" />

    <style name="AppThemeParent" parent="AppTheme" />

    <style name="AppThemeParentDark" parent="AppThemeDark" />

    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.AppCompat.Dark" />

    <style name="Divider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/card_border</item>
    </style>

    <style name="ItemTextAppearance">
        <item name="android:ellipsize">middle</item>
    </style>

</resources>
