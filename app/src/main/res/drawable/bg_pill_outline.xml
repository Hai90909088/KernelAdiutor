<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#1529b6f6" />
            <stroke
                android:width="1.5dp"
                android:color="@color/cyan_accent" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/pill_bg" />
            <stroke
                android:width="1.5dp"
                android:color="@color/pill_border" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</selector>
